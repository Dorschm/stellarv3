# ─── Self-hosted backend configuration ──────────────────────────────────────
#
# Copy this file to `.env` (gitignored) and fill in real values. The Server
# (src/server/Server.ts → dotenv.config()) loads it on boot for the master
# and every worker process. All entries are optional unless marked
# REQUIRED — the server starts without them but exposes the corresponding
# feature as a clear 503/501 response so the client UI can degrade.

# ── Discord OAuth (REQUIRED for Discord login) ──────────────────────────────
# Register an application at https://discord.com/developers/applications,
# add an OAuth2 redirect that exactly matches DISCORD_REDIRECT_URI below.
# The bot scope is NOT needed — only `identify`.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/login/discord/callback

# ── JWT signing (REQUIRED for any auth endpoint) ────────────────────────────
# Generate a long random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Access-token issuer + lifetime ──────────────────────────────────────────
# `API_BASE_URL` becomes the `iss` claim on minted JWTs. The CLIENT compares
# its `getApiBase()` against this — so:
#   - Leave empty when the API and the game live on the same origin.
#   - Set to "https://api.example.com" when the API has its own domain. In
#     that case also build the client with API_DOMAIN=api.example.com.
API_BASE_URL=
ACCESS_TOKEN_TTL_SEC=900

# ── Refresh-cookie attributes ───────────────────────────────────────────────
# Domain is optional (host-only by default). COOKIE_SECURE defaults to true
# in production / false otherwise — override only if you're doing something
# unusual (e.g. terminating TLS upstream and forwarding plain HTTP).
COOKIE_DOMAIN=
COOKIE_SECURE=

# ── SQLite database location ────────────────────────────────────────────────
# Default: ./data/userdb.sqlite (created automatically). Use ":memory:" for
# a non-persistent transient DB (useful in CI).
USERDB_PATH=

# ── Client build-time API base override ─────────────────────────────────────
# Used by `vite.config.ts` to inject `process.env.API_DOMAIN` into the
# client bundle. Leave unset to use same-origin (recommended for single-host
# deployments).
API_DOMAIN=
